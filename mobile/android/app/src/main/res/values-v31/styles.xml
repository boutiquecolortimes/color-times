<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@color/app_bg</item>
    </style>

    <!-- Android 12+ system splash: gold monogram on warm ink (no white flash, no default robot). -->
    <style name="AppTheme.Launch" parent="AppTheme">
        <item name="android:windowSplashScreenBackground">@color/brand_ink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand_ink</item>
    </style>

</resources>
