# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/color-times-boutique?retryWrites=true&w=majority

# Auth (JWT)
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Vercel Blob (image/file storage)
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Brevo (WhatsApp / email / SMS notifications)
BREVO_API_KEY=

# Meta WhatsApp Cloud API (alternative to Brevo — see Admin > WhatsApp > Provider)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
# Any secret string you choose — set it here AND paste the same value (not
# this variable name) into Meta App > WhatsApp > Configuration > Webhook as
# the "Verify token". Without this set, Meta's webhook verification always
# fails with "callback URL or verify token couldn't be validated".
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
